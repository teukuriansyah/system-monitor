{
  "expo": {
    "name": "System Monitor",
    "slug": "system-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/screen.png",
    "scheme": "systemmonitor",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/screen.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ishida24.systemmonitor"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./src/assets/screen.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
